# Ambiente LOCAL apenas. Nenhum valor aqui é um segredo real (docs/07-Seguranca.md §8).
# Copie para ".env" no mesmo diretório antes de subir o Docker Compose.
# Nunca reutilize estes valores em Development/Staging/Production (docs/14-DevOps.md §3).

# SQL Server
MSSQL_SA_PASSWORD=Dev_OnlyChangeMe_123!
SQLSERVER_PORT=1433

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=eip_dev
RABBITMQ_PASSWORD=Dev_OnlyChangeMe_123!
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (Object Storage compatível com S3)
MINIO_ROOT_USER=eip_dev
MINIO_ROOT_PASSWORD=Dev_OnlyChangeMe_123!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
