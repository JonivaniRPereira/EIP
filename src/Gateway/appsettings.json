{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "ReverseProxy": {
    "Routes": {
      "platform-route": {
        "ClusterId": "platform-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "platform-cluster": {
        "Destinations": {
          "host": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  }
}
